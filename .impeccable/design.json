  "components": [
    {
      "name": "Outlined action",
      "kind": "button",
      "refersTo": "action",
      "description": "Full-width square production action; hover inverts the warm screen ink.",
      "html": "<button type=\"button\" class=\"ds-action\"><span>Build this campaign</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 19 19 5M5 5h14v14\"/></svg></button>",
      "css": ".ds-action{width:100%;min-height:53px;padding:17px 19px;border:1px solid #ece9e18a;border-radius:0;display:inline-flex;justify-content:space-between;align-items:center;gap:30px;background:transparent;color:var(--ink,#ece9e1);font-family:var(--font-mono,Mono,monospace);font-size:12px;line-height:1.3;text-transform:uppercase;text-align:left;cursor:pointer;transition:background .2s,color .2s}.ds-action svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:1.2;flex-shrink:0}.ds-action:hover{background:var(--ink,#ece9e1);color:#111}.ds-action:disabled{opacity:.5;cursor:wait}.ds-action:focus-visible,.ds-text-button:focus-visible,.ds-field:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible,.ds-photo:focus-visible,.ds-vhs:focus-visible,.ds-motion-toggle:focus-visible{outline:2px solid var(--ink,#ece9e1);outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-action{transition:none}}"
    },
    {
      "name": "Underlined text action",
      "kind": "button",
      "refersTo": "text-button",
      "description": "Small secondary action used for removal, refresh and other local operations.",
      "html": "<button type=\"button\" class=\"ds-text-button\">Remove logo</button>",
      "css": ".ds-text-button{border:0;border-bottom:1px solid var(--quiet,#b5b2aa);border-radius:0;padding:4px 0;background:transparent;color:var(--ink,#ece9e1);font-family:var(--font-mono,Mono,monospace);font-size:11px;text-transform:uppercase;cursor:pointer}.ds-text-button:hover{color:#fff;border-color:#fff}.ds-text-button:disabled{opacity:.5;cursor:wait}.ds-action:focus-visible,.ds-text-button:focus-visible,.ds-field:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible,.ds-photo:focus-visible,.ds-vhs:focus-visible,.ds-motion-toggle:focus-visible{outline:2px solid var(--ink,#ece9e1);outline-offset:6px}"
    },
    {
      "name": "Labelled operating field",
      "kind": "input",
      "refersTo": "field",
      "description": "Square charcoal field with a persistent label and sentence-case value.",
      "html": "<label class=\"ds-field-label\" for=\"ds-brand-name\">Brand name<input class=\"ds-field\" id=\"ds-brand-name\" name=\"brand\" placeholder=\"Your brand\" maxlength=\"24\" /></label>",
      "css": ".ds-field-label{display:flex;flex-direction:column;gap:10px;color:var(--ink,#ece9e1);font-family:var(--font-mono,Mono,monospace);font-size:11px;line-height:1.4;text-transform:uppercase}.ds-field{width:100%;background:#191919;color:var(--ink,#ece9e1);border:1px solid #ece9e13d;padding:14px 13px;min-height:48px;border-radius:0;font-family:var(--font-sans,Montreal,Arial,sans-serif);font-size:15px;line-height:1.35;text-transform:none;caret-color:var(--ink,#ece9e1)}.ds-field::placeholder{color:#a39f96}.ds-field:focus-visible{outline:2px solid var(--ink,#ece9e1);outline-offset:2px}.ds-field[aria-invalid=\"true\"]{border-color:#ad6655}@media(max-width:600px){.ds-field{font-size:16px;padding:13px 11px}}"
    },
    {
      "name": "Perimeter navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Compact Mono links with native full-page route navigation, square current-page marker and transparent mobile hit regions; SiteLink renders ordinary anchors.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"/campaigns\" aria-current=\"page\">Campaigns</a><a href=\"/how-it-works\">How</a><a href=\"/about\">About</a></nav>",
      "css": ".ds-nav{display:flex;justify-content:flex-end;gap:26px;padding-top:9px;color:var(--ink,#ece9e1);font-family:var(--font-mono,Mono,monospace);font-size:12px;line-height:1.1;letter-spacing:-.025em;text-transform:uppercase}.ds-nav a{position:relative;color:inherit;text-decoration:none;transition:color .2s}.ds-nav a:hover{color:#fff}.ds-nav a[aria-current=\"page\"]:before{content:\"\";position:absolute;width:7px;height:7px;background:var(--ink,#ece9e1);right:calc(100% + 7px);top:1px}.ds-action:focus-visible,.ds-text-button:focus-visible,.ds-field:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible,.ds-photo:focus-visible,.ds-vhs:focus-visible,.ds-motion-toggle:focus-visible{outline:2px solid var(--ink,#ece9e1);outline-offset:6px}@media(max-width:600px){.ds-nav{gap:20px;font-size:10px;line-height:1.2;padding-top:5px}.ds-nav a:after{content:\"\";position:absolute;width:max(100%,44px);height:44px;left:50%;top:50%;transform:translate(-50%,-50%)}.ds-nav a[aria-current=\"page\"]:before{width:5px;height:5px;right:calc(100% + 5px);top:2px}}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none}}"
    },
    {
      "name": "Catalogue filter tab",
      "kind": "chip",
      "refersTo": "filter-tab",
      "description": "Text-led category filter with explicit selected state and an ink underline.",
      "html": "<div class=\"ds-filters\" role=\"group\" aria-label=\"Campaign category\"><button type=\"button\" class=\"ds-filter\" aria-pressed=\"true\">All formats</button><button type=\"button\" class=\"ds-filter\" aria-pressed=\"false\">Fashion</button><button type=\"button\" class=\"ds-filter\" aria-pressed=\"false\">Art</button></div>",
      "css": ".ds-filters{display:flex;gap:25px;flex-wrap:wrap}.ds-filter{font-family:var(--font-mono,Mono,monospace);font-size:11px;text-transform:uppercase;color:var(--quiet,#b5b2aa);padding:5px 0;background:transparent;border:0;border-radius:0;cursor:pointer}.ds-filter[aria-pressed=\"true\"]{color:var(--ink,#ece9e1);border-bottom:1px solid var(--ink,#ece9e1)}.ds-action:focus-visible,.ds-text-button:focus-visible,.ds-field:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible,.ds-photo:focus-visible,.ds-vhs:focus-visible,.ds-motion-toggle:focus-visible{outline:2px solid var(--ink,#ece9e1);outline-offset:6px}"
    },
    {
      "name": "Booking summary container",
      "kind": "card",
      "refersTo": "booking-summary",
      "description": "Tonal square summary with ruled estimate rows; the sample does not fabricate commercial amounts.",
      "html": "<aside class=\"ds-summary\" aria-label=\"Campaign summary\"><div class=\"ds-summary-content\"><span>01 / CAMPAIGN CONCEPT</span><h2>The Street Runway</h2><p>Starting production estimate</p><dl><div><dt>Market</dt><dd>New York / USD</dd></div><div class=\"ds-summary-total\"><dt>Final quote</dt><dd>After scope review</dd></div></dl><p class=\"ds-summary-note\">Date, location and scope are approved before payment.</p></div></aside>",
      "css": ".ds-summary{background:#171717;color:var(--ink,#ece9e1);border-radius:0;min-width:0}.ds-summary-content{padding:27px}.ds-summary-content>span{font-family:var(--font-mono,Mono,monospace);font-size:9px;color:var(--quiet,#b5b2aa)}.ds-summary h2{font-family:var(--font-display,Advercase,Georgia,serif);font-size:33px;line-height:.99;letter-spacing:-.035em;font-weight:400;margin:12px 0}.ds-summary p{font-family:var(--font-sans,Montreal,Arial,sans-serif);font-size:12px;line-height:1.55;color:var(--quiet,#b5b2aa);margin:0}.ds-summary dl{margin:25px 0 15px;padding:0}.ds-summary dl>div{display:flex;justify-content:space-between;gap:25px;font-family:var(--font-sans,Montreal,Arial,sans-serif);font-size:12px;color:var(--quiet,#b5b2aa);padding:11px 0}.ds-summary dd{margin:0;white-space:nowrap}.ds-summary .ds-summary-total{padding-top:17px;border-top:1px solid var(--line,#ece9e12e);color:var(--ink,#ece9e1);font-size:14px}.ds-summary .ds-summary-note{border-top:1px solid var(--line,#ece9e12e);padding-top:20px;font-size:11px}"
    },
    {
      "name": "Concept photographic panel",
      "kind": "custom",
      "description": "Square image panel and concept caption; the inline SVG is a structural placeholder, not campaign artwork.",
      "html": "<figure class=\"ds-photo-panel\"><button type=\"button\" class=\"ds-photo\" aria-label=\"Enlarge campaign concept photograph\"><svg class=\"ds-photo-placeholder\" viewBox=\"0 0 600 400\" role=\"img\" aria-label=\"Concept photograph placeholder\"><rect width=\"600\" height=\"400\" fill=\"#202020\"/><path d=\"M40 40H560V360H40Z\" fill=\"none\" stroke=\"#b5b2aa\" opacity=\".25\"/><text x=\"300\" y=\"205\" text-anchor=\"middle\" fill=\"#b5b2aa\" font-family=\"monospace\" font-size=\"12\">CONCEPT PHOTOGRAPH</text></svg><span class=\"ds-photo-enlarge\">[Enlarge ↗]</span></button><figcaption><span>01 / Art direction</span><span>Concept visualization</span></figcaption></figure>",
      "css": ".ds-photo-panel{display:flex;flex-direction:column;gap:8px;margin:0;color:var(--quiet,#b5b2aa);font-family:var(--font-mono,Mono,monospace);font-weight:500;text-transform:uppercase;letter-spacing:-.025em}.ds-photo{position:relative;display:block;width:100%;padding:0;border:0;border-radius:0;background:#151515;overflow:hidden;cursor:pointer}.ds-photo-placeholder{display:block;width:100%;height:100%;object-fit:cover}.ds-photo-enlarge{position:absolute;left:18px;bottom:16px;font-size:11px;line-height:1.2;color:#fff;text-shadow:0 1px 5px #000;opacity:0;transform:translateY(3px);transition:opacity .2s,transform .2s}.ds-photo:hover .ds-photo-enlarge,.ds-photo:focus-visible .ds-photo-enlarge{opacity:1;transform:none}.ds-photo-panel figcaption{display:flex;justify-content:space-between;gap:15px;align-items:baseline;font-size:10px;line-height:1.1}.ds-photo-panel figcaption>span:last-child{font-size:9px;opacity:.75}.ds-action:focus-visible,.ds-text-button:focus-visible,.ds-field:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible,.ds-photo:focus-visible,.ds-vhs:focus-visible,.ds-motion-toggle:focus-visible{outline:2px solid var(--ink,#ece9e1);outline-offset:6px}@media(max-width:1024px){.ds-photo-enlarge{opacity:1}}@media(prefers-reduced-motion:reduce){.ds-photo-enlarge{transition:none}}"
    },
    {
      "name": "Profile VHS object",
      "kind": "custom",
      "description": "Small profile sleeve with the actual physical silhouette and hover/focus cassette reveal; inline artwork is a structural sample.",
      "html": "<a class=\"ds-vhs\" href=\"/campaigns\" aria-label=\"Explore the campaign tapes\"><span class=\"ds-vhs-cassette\" aria-hidden=\"true\"><i></i><i></i></span><span class=\"ds-vhs-sleeve\" aria-hidden=\"true\"><span class=\"ds-vhs-brand\">AICANFEEL</span><svg class=\"ds-vhs-art\" viewBox=\"0 0 82 62\"><rect width=\"82\" height=\"62\" fill=\"#202020\"/><path d=\"M10 50 32 10 50 50 70 22\" fill=\"none\" stroke=\"#b5b2aa\" stroke-width=\"1\"/></svg><span class=\"ds-vhs-title\">STREET<br/>VIDEO</span><span class=\"ds-vhs-edition\">OFFLINE / CAMPAIGN CONCEPTS</span></span></a>",
      "css": ".ds-vhs{position:relative;display:block;width:92px;height:139px;margin:0 auto;isolation:isolate;perspective:600px;outline-offset:8px;color:var(--ink,#ece9e1);text-decoration:none}.ds-vhs-cassette{position:absolute;inset:5px 7px 2px;background:#101010;border:1px solid #333;border-radius:5px;display:flex;align-items:center;justify-content:space-evenly;box-shadow:inset 0 0 0 2px #090909;transition:transform .5s cubic-bezier(.16,1,.3,1)}.ds-vhs-cassette i{width:23px;height:23px;border:5px solid #4a4841;background:#111;border-radius:50%;box-shadow:inset 0 0 0 3px #272622}.ds-vhs-sleeve{position:absolute;inset:0;display:flex;flex-direction:column;overflow:hidden;background:#171716;border:1px solid #77736a;box-shadow:inset 2px 0 0 #aaa59650,inset -2px 0 0 #000,1px 2px 5px #0007;transform:rotateY(-5deg);transition:transform .5s cubic-bezier(.16,1,.3,1)}.ds-vhs-brand{font-family:var(--font-display,Advercase,Georgia,serif);font-size:17px;letter-spacing:-.04em;line-height:1.05;padding:5px 2px 2px}.ds-vhs-art{display:block;width:calc(100% - 10px);height:62px;margin:0 5px;border:1px solid #d7d2c04a}.ds-vhs-title{font-family:var(--font-display,Advercase,Georgia,serif);font-size:23px;line-height:.78;letter-spacing:-.035em;padding:6px 2px 2px;text-align:center}.ds-vhs-edition{font-family:var(--font-mono,Mono,monospace);font-size:3.3px;line-height:1.2;letter-spacing:-.02em;margin-top:auto;padding:4px 2px 5px;color:var(--quiet,#b5b2aa)}.ds-vhs:hover .ds-vhs-cassette,.ds-vhs:focus-visible .ds-vhs-cassette{transform:translate(12px,-10px) rotate(2deg)}.ds-vhs:hover .ds-vhs-sleeve,.ds-vhs:focus-visible .ds-vhs-sleeve{transform:translate(-2px,1px) rotateY(-10deg)}.ds-action:focus-visible,.ds-text-button:focus-visible,.ds-field:focus-visible,.ds-nav a:focus-visible,.ds-filter:focus-visible,.ds-photo:focus-visible,.ds-vhs:focus-visible,.ds-motion-toggle:focus-visible{outline:2px solid var(--ink,#ece9e1);outline-offset:6px}@media(prefers-reduced-motion:reduce){.ds-vhs-cassette,.ds-vhs-sleeve{transition:none}}"
    },
    {
      "name": "Motion placement study",
      "kind": "custom",
      "description": "Self-contained static excerpt of the original installation diagram grammar; application pause and personalisation live in the actual component.",
      "html": "<div class=\"ds-motion\"><svg class=\"ds-motion-svg\" viewBox=\"0 0 800 600\" role=\"img\" aria-labelledby=\"ds-motion-title ds-motion-desc\"><title id=\"ds-motion-title\">Campaign placement study</title><desc id=\"ds-motion-desc\">A static geometric excerpt showing a circular installation and local brand position.</desc><g fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><g class=\"ds-motion-labels\" stroke=\"none\" fill=\"currentColor\"><text x=\"44\" y=\"58\">AICANFEEL</text><text x=\"756\" y=\"58\" text-anchor=\"end\">OFFLINE / IN MOTION</text></g><g opacity=\".25\"><path d=\"M38 104H50M44 98V110M750 104H762M756 98V110M38 496H50M44 490V502M750 496H762M756 490V502\"/></g><circle cx=\"400\" cy=\"312\" r=\"122\"/><ellipse cx=\"400\" cy=\"312\" rx=\"175\" ry=\"46\"/><ellipse cx=\"400\" cy=\"312\" rx=\"46\" ry=\"175\"/><circle cx=\"400\" cy=\"312\" r=\"32\"/><text x=\"400\" y=\"320\" text-anchor=\"middle\" fill=\"currentColor\" stroke=\"none\" font-family=\"monospace\" font-size=\"12\">YOUR BRAND</text><text class=\"ds-motion-footer\" x=\"44\" y=\"553\" fill=\"currentColor\" stroke=\"none\">INSTALLATION / PLACEMENT STUDY</text></g></svg><span class=\"ds-motion-note\">BRAND PLACEMENT STUDY / NOT FINAL ARTWORK</span></div>",
      "css": ".ds-motion{position:relative;min-width:0;background:#ee7732;color:#101113;overflow:hidden}.ds-motion-svg{display:block;width:100%;height:auto}.ds-motion-labels text{font-family:var(--font-mono,Mono,monospace);font-size:12px;letter-spacing:1.3px;font-weight:500}.ds-motion-footer{font-family:var(--font-mono,Mono,monospace);font-size:11px;letter-spacing:1.4px}.ds-motion-note{position:absolute;bottom:14px;left:16px;font-family:var(--font-mono,Mono,monospace);font-size:8px}"
    },
    {
      "name": "Labelled receipt status",
      "kind": "custom",
      "description": "Ruled status banner with a small sage square and explicit explanatory text.",
      "html": "<section class=\"ds-status\" aria-label=\"Request status\"><span class=\"ds-status-square\" aria-hidden=\"true\"></span><div><h2>Brief received</h2><p>Your production scope is reviewed before payment.</p></div></section>",
      "css": ".ds-status{display:flex;align-items:flex-start;gap:20px;border-top:1px solid var(--line,#ece9e12e);border-bottom:1px solid var(--line,#ece9e12e);padding:28px 0;margin-bottom:40px;color:var(--ink,#ece9e1)}.ds-status-square{width:9px;height:9px;background:#b6cb95;flex-shrink:0;margin-top:10px}.ds-status h2{font-family:var(--font-display,Advercase,Georgia,serif);font-weight:400;font-size:30px;line-height:.99;letter-spacing:-.035em;margin:0 0 10px}.ds-status p{font-family:var(--font-sans,Montreal,Arial,sans-serif);font-size:14px;line-height:1.55;color:var(--quiet,#b5b2aa);max-width:700px;margin:0}@media(max-width:600px){.ds-status{gap:15px;padding:23px 0;margin-bottom:30px}.ds-status h2{font-size:28px}}"
    }
  ],
  "narrative": {
    "northStar": "The CRT Campaign Archive",
    "overview": "The visual authority is the user's pinned arcmarumo.com design: a black television screen, quietly luminous perimeter controls and a carousel of dimensional, weathered VHS sleeves. AICANFEEL supplies the identity and campaign artwork within that composition. Physical objects and photographs lead; compact metadata identifies the offer and the next action. The world is already defined in code and must remain coherent as screens are added.\n\nAdvercase gives editorial content a distinctive serif voice. Mono and Bit keep navigation, indexing and tape furniture deliberately mechanical. Black glass, smoky print, chipped sleeve folds and restrained inertia create material depth. Campaign colour belongs to the selected artwork or brand-placement study; the surrounding instrument stays dark and quiet.\n\nThere are two surface modes within this identity. Discovery surfaces use tapes, photographic reels and editorial rhythm. Booking, the private receipt and the owner production desk retain the CRT shell but use labelled fields, ruled records, explicit status and ordinary vertical scrolling. A precise working interface is an intended expression of the world.",
    "keyCharacteristics": [
      "Curved black CRT shell with fixed pixel/mono perimeter navigation.",
      "Actual three-dimensional VHS sleeves with original campaign cover art.",
      "Horizontal photographic narrative on desktop; vertical narrative on smaller screens.",
      "Advercase editorial hierarchy with restrained, uppercase Mono metadata.",
      "Square operating controls, fine rules, clear currencies and visible state.",
      "Authored concept imagery and geometric SVG placement studies with honest labels."
    ],
    "rules": [
      {
        "name": "The Campaign Boundary Rule",
        "body": "Keep campaign palettes inside artwork, selected campaign emphasis and the local placement study; retain the shared black/ink/quiet instrument around them.",
        "section": "colors"
      },
      {
        "name": "The Two Voices Rule",
        "body": "Use Advercase for editorial titles and Mono/Bit for the archive's controls; keep editable prose and operational explanations in Montreal.",
        "section": "typography"
      },
      {
        "name": "The Material Depth Rule",
        "body": "Use curved glass and sleeve construction for dimensional emphasis; keep working forms, lists and photographic panels square and quiet.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** preserve the pinned black CRT, pixel/mono perimeter, Advercase content and dimensional weathered tape composition.",
      "**Do** keep discovery and Operate surfaces recognisably in one world while giving forms, status and owner records direct labels and ordinary reading order.",
      "**Do** use each campaign's palette consistently across its nine-image concept sequence, sleeve and local placement study.",
      "**Do** retain the two-line offline-campaign/filmmaker/Live explanation in short viewports and keep it clear of the sleeve and perimeter controls.",
      "**Do** preserve focus, keyboard alternatives, independent touch targets, reduced motion and real SVG Pause/Play behavior.",
      "**Do** keep generated imagery labelled as campaign concepts and preserve its provenance."
    ],
    "donts": [
      "**Don't** replace this pinned interface with a generic landing page, uniform card grid, new palette or new typographic identity.",
      "**Don't** promote a selected campaign colour or a local preview colour into the shared application theme.",
      "**Don't** remove semantic navigation or overview access when adding direct manipulation, motion or visual effects.",
      "**Don't** present concept boards, generated code motifs or on-location visualisations as executed client work, functional QR codes, measured results or committed scenery.",
      "**Don't** let stale responses, return URLs or purely decorative status colours imply a customer's production or payment state."
    ]
  }
}
